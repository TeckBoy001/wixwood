# Copy this file to .env and fill in the values.
# Nothing else needs to be created by hand — the database file and its
# table are created automatically the first time the server starts.

# A long, random password only WixWood staff know. Used to open the
# admin moderation page and to approve/reject/delete reviews.
# Generate one with: openssl rand -hex 24
ADMIN_TOKEN=change-this-to-a-long-random-string

# The exact origin(s) of the live WixWood website, comma-separated.
# This is what stops other websites from submitting reviews through
# your API. Example: https://wixwoodcrafts.com,https://www.wixwoodcrafts.com
ALLOWED_ORIGINS=

# Port the server listens on. Most hosts (Render, Railway, Fly.io) set
# this automatically — you usually don't need to touch it.
PORT=3000

# ---- Optional: online payment for the small set of fixed-price items
# (stool, cup, bowl, serving board) listed in catalog.json. Custom/quote
# furniture is unaffected either way — that always goes through WhatsApp.
# Leave these blank and checkout will say online payment isn't ready yet;
# the order is still created and WixWood can arrange payment manually. ----
# From your Paystack dashboard → Settings → API Keys & Webhooks.
# Use the sk_test_... / pk_test_... pair until you're ready to go live.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Where Paystack sends the customer back after paying, e.g.
# https://wixwoodcrafts.com/order-confirmation.html
PAYSTACK_CALLBACK_URL=
# Also paste this backend's own URL + /api/webhooks/paystack into
# Paystack's dashboard under Settings → API Keys & Webhooks → Webhook URL,
# e.g. https://wixwood-reviews.onrender.com/api/webhooks/paystack
# That webhook is what actually marks an order paid — the "callback_url"
# above is only where the customer's browser lands, it's not trusted.

# ---- Optional: email notification when a new review comes in ----
# Leave all of these blank to skip email notifications entirely; the
# review system works fine without them (you'd just check the admin
# page periodically instead of getting pinged).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
